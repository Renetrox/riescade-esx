    <!-- Swatch's proven ES-X carousel, moved to Riescade coordinates. -->
  <textlist name="gamelist">
    <!-- Texto oculto: el carrusel trabaja visualmente con artwork -->
    <selectorColor>FFFFFF00</selectorColor>
    <selectedColor>FFFFFF00</selectedColor>
    <primaryColor>FFFFFF00</primaryColor>
    <secondaryColor>FFFFFF00</secondaryColor>

    <!-- Fuente nativa de Riescade -->
    <fontPath>./resources/fonts/OpenSans-Light.ttf</fontPath>
    <lineSpacing>1.00</lineSpacing>

    <!-- Geometría probada del Swatch PS5 -->
    <alignment>left</alignment>
    <size>1.00 0.35</size>
    <pos>-0.021 0.069</pos>
    <zIndex>100</zIndex>

    <!-- Carrusel horizontal ES-X -->
    <orientation>horizontal</orientation>
    <carouselMode>true</carouselMode>
    <carouselLoop>true</carouselLoop>

    <!-- Sin fondos artificiales: el aspecto de card lo dan
         el artwork y los frames de Riescade -->
    <carouselItemColor>00000000</carouselItemColor>
    <carouselSelectedItemColor>00000000</carouselSelectedItemColor>

    <!-- Artwork -->
    <carouselImage>true</carouselImage>
    <carouselImageType>wheel</carouselImageType>
    <carouselFallbackImage>./resources/systemicons/p.png</carouselFallbackImage>

    <carouselImageFit>contain</carouselImageFit>
    <carouselImagePadding>0.004 0.006</carouselImagePadding>

    <!-- Mantener todas las tarjetas con una caja estable.
         LockSize sin BoxSize no hacía realmente nada. -->
    <carouselImageLockSize>true</carouselImageLockSize>
    <carouselImageBoxSize>0.067 0.521</carouselImageBoxSize>
    <carouselImageZIndex>20</carouselImageZIndex>

    <carouselShowText>false</carouselShowText>

    <!-- Marcos reales de Riescade.
         logo_default.png NO conviene aquí porque ES-X dibuja
         carouselImageBorder como overlay encima del artwork. -->
    <carouselImageBorder>./resources/_parts/logo_default.png</carouselImageBorder>
    <carouselImageBorderSelected>./resources/_parts/logo_default.png</carouselImageBorderSelected>
    <carouselImageBorderFit>contain</carouselImageBorderFit>
    <carouselImageBorderScale>1.11</carouselImageBorderScale>
    <carouselImageBorderColor>FFFFFFFF</carouselImageBorderColor>
    <carouselImageBorderZIndex>10</carouselImageBorderZIndex>

    <!-- Tamaño y escala del Swatch que ya sabemos que funcionan -->
    <logoScale>1.40</logoScale>
    <logoSize>0.067 0.521</logoSize>
    

    <!-- Posición fina dentro del área del carrusel -->
    <logoOffsetX>-0.330</logoOffsetX>
    <logoOffsetY>-0.004</logoOffsetY>
    <logoAlignment>top</logoAlignment>

    <!-- Distribución -->
    <logoSpacingX>0.083</logoSpacingX>
    <scaledLogoSpacing>0.90</scaledLogoSpacing>
    <maxLogoCount>6</maxLogoCount>
    <minLogoOpacity>0.90</minLogoOpacity>

    <!-- Sonido original de Riescade -->
    <scrollSound>./resources/sounds/click.ogg</scrollSound>
</textlist>


